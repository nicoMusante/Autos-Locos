# Copiá este archivo como .env.local y completá con tu connection string real de Neon.
# .env.local NUNCA se sube a git (ya está en .gitignore).
DATABASE_URL="postgresql://usuario:password@ep-xxxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Secret para firmar los JWT de sesión. Generar uno con: npx auth secret
AUTH_SECRET="reemplazar-con-un-secret-generado"

# Opcional: login con Google. Sin estas dos completas, auth.ts no agrega el
# provider y el login por mail/contraseña sigue funcionando igual.
# OAuth Client ID de Google Cloud Console (tipo "Web application").
# Redirect URI en dev: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="reemplazar-con-tu-client-id"
GOOGLE_CLIENT_SECRET="reemplazar-con-tu-client-secret"
